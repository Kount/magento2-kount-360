<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Kount\Kount360\Api\Data\RisInterface" type="Kount\Kount360\Model\Ris"/>
    <preference for="Kount\Kount360\Api\RisRepositoryInterface" type="Kount\Kount360\Service\RisRepository"/>
    <preference for="Kount\Kount360\Api\Data\OrderQueueMessageInterface" type="Kount\Kount360\Model\Queue\OrderQueueMessage"/>
    <virtualType name="Kount\Kount360\Model\Session\Storage" type="Magento\Framework\Session\Storage">
        <arguments>
            <argument name="namespace" xsi:type="string">kount</argument>
        </arguments>
    </virtualType>
    <type name="Kount\Kount360\Model\Session">
        <arguments>
            <argument name="storage" xsi:type="object">Kount\Kount360\Model\Session\Storage</argument>
        </arguments>
    </type>
    <type name="Kount\Kount360\Model\Logger\Handler\Kount">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Kount\Kount360\Model\Logger" >
        <arguments>
            <argument name="name" xsi:type="string">main</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Kount\Kount360\Model\Logger\Handler\Kount</item>
            </argument>
        </arguments>
    </type>
    <type name="Kount\Kount360\Model\ApiClient">
        <arguments>
            <argument name="clientConfig" xsi:type="array">
                <item name="timeout" xsi:type="number">20</item>
                <item name="connect_timeout" xsi:type="number">10</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Sales\Model\Order\Payment\State\RegisterCaptureNotificationCommand">
        <plugin name="kount" type="Kount\Kount360\Plugin\Sales\Payment\RegisterCaptureNotificationCommand"/>
    </type>
    <type name="Kount\Kount360\Model\Ens\Manager">
        <arguments>
            <argument name="supportedEvents" xsi:type="array">
                <item name="Order.StatusChange" xsi:type="string">Order.StatusChange</item>
                <item name="Order.NotesAdd" xsi:type="string">Order.NotesAdd</item>
            </argument>
        </arguments>
    </type>
    <type name="Kount\Kount360\Model\Ens\EventHandlerFactory">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="Order.StatusChange" xsi:type="object">Kount\Kount360\Model\Ens\EventHandler\StatusEdit</item>
                <item name="Order.NotesAdd" xsi:type="object">Kount\Kount360\Model\Ens\EventHandler\NotesAdd</item>
            </argument>
        </arguments>
    </type>
    <preference for="Kount\Kount360\Model\Observer\ConditionInterface" type="Kount\Kount360\Model\Observer\Condition"/>
    <virtualType name="Kount\Kount360\Model\Observer\PaymentPlaceStart\Condition" type="Kount\Kount360\Model\Observer\Condition" />
    <type name="Kount\Kount360\Observer\PaymentPlaceStart">
        <arguments>
            <argument name="condition"  xsi:type="object">Kount\Kount360\Model\Observer\PaymentPlaceStart\Condition</argument>
        </arguments>
    </type>
    <virtualType name="Kount\Kount360\Model\Observer\PaymentPlaceEnd\Condition" type="Kount\Kount360\Model\Observer\Condition">
        <arguments>
            <argument name="default"  xsi:type="boolean">true</argument>
            <argument name="conditions"  xsi:type="array">
                <item name="authorizenet_directpost" xsi:type="string">Kount\Kount360\Observer\PaymentPlaceEnd\Condition\AuthorizeDirectPost</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Kount\Kount360\Observer\PaymentPlaceEnd">
        <arguments>
            <argument name="condition"  xsi:type="object">Kount\Kount360\Model\Observer\PaymentPlaceEnd\Condition</argument>
        </arguments>
    </type>
    <virtualType name="Kount\Kount360\Model\Observer\SubmitAllAfter\Condition" type="Kount\Kount360\Model\Observer\Condition">
        <arguments>
            <argument name="default"  xsi:type="boolean">true</argument>
            <argument name="conditions"  xsi:type="array">
                <item name="payflow_link" xsi:type="object">Kount\Kount360\Model\Observer\Condition\Negative</item>
                <item name="payflow_advanced" xsi:type="object">Kount\Kount360\Model\Observer\Condition\Negative</item>
                <item name="authorizenet_directpost" xsi:type="object">Kount\Kount360\Model\Observer\Condition\Negative</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Kount\Kount360\Model\WorkflowFactory">
        <arguments>
            <argument name="workflows" xsi:type="array">
                <item name="pre_auth" xsi:type="object">Kount\Kount360\Model\Workflow\PreAuth</item>
                <item name="post_auth" xsi:type="object">\Kount\Kount360\Model\Workflow\PostAuth</item>
            </argument>
        </arguments>
    </type>
    <type name="Kount\Kount360\Observer\SubmitAllAfter">
        <arguments>
            <argument name="condition" xsi:type="object">Kount\Kount360\Model\Observer\SubmitAllAfter\Condition</argument>
        </arguments>
    </type>
    <virtualType name="Kount\Kount360\Model\Observer\QuoteSubmitFailure\Condition" type="Kount\Kount360\Model\Observer\Condition" />
    <type name="Kount\Kount360\Observer\QuoteSubmitFailure">
        <arguments>
            <argument name="condition"  xsi:type="object">Kount\Kount360\Model\Observer\QuoteSubmitFailure\Condition</argument>
        </arguments>
    </type>
</config>
